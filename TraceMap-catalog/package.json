{
  "name": "tracemap",
  "version": "0.2.0",
  "description": "Static, single-file HTML compliance catalog generator — YAML data in, self-contained HTML out",
  "main": "build.js",
  "scripts": {
    "build": "node build.js --data data",
    "build:example": "node build.js --data data-example",
    "generate-template": "node scripts/generate-template.js",
    "generate-template:example": "node scripts/generate-template.js --catalog data-example/catalog.yaml",
    "generate-template:fixture": "node scripts/generate-template.js --catalog data-example/catalog.yaml --populate data-example --out data-example/tracemap-example.xlsx",
    "import": "node scripts/import-xlsx.js",
    "export-xlsx": "node scripts/generate-template.js --populate data --out dist/tracemap-export.xlsx",
    "test": "node --test \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
